<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 Android TV launcher banner -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#3B1FB8" android:endColor="#6C4DF6" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" android:gravity="center"
        android:width="180dp" android:height="180dp" />
</layer-list>
