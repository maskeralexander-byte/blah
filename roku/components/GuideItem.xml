<?xml version="1.0" encoding="utf-8" ?>
<!-- One row in the on-screen guide: number + channel name, what's on now, what's next. -->
<component name="GuideItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/GuideItem.brs" />
    <children>
        <Rectangle id="bg" width="760" height="112" color="0x00000000" />
        <Rectangle id="bar" translation="[24, 98]" width="0" height="4" color="0x8B73FFFF" />
        <Label id="name" translation="[24, 10]" width="712" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
        <Label id="now" translation="[24, 48]" width="712" font="font:SmallSystemFont" color="0xDDDDE8FF" />
        <Label id="next" translation="[24, 74]" width="712" font="font:SmallestSystemFont" color="0x9999AAFF" />
    </children>
</component>
