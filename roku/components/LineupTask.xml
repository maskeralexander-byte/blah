<?xml version="1.0" encoding="utf-8" ?>
<!--
  Builds the TV's own channel lineup: downloads the English playlist and the free guide feeds,
  parses them, and caches the result. mode = "cache" returns the saved copy right away;
  mode = "refresh" downloads what's stale (playlist daily, guide every 3 hours).
-->
<component name="LineupTask" extends="Task">
    <interface>
        <field id="mode" type="string" value="refresh" />
        <field id="force" type="boolean" />
        <field id="lineup" type="assocarray" alwaysNotify="true" />
        <!-- What it's doing right now, shown on the loading screen. -->
        <field id="progress" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/LineupTask.brs" />
    <script type="text/brightscript" uri="pkg:/source/Lineup.brs" />
</component>
