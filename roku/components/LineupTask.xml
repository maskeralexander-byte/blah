<?xml version="1.0" encoding="utf-8" ?>
<!-- Fetches the channel lineup (channels + guide) from the phone app, falling back to the saved copy. -->
<component name="LineupTask" extends="Task">
    <interface>
        <field id="uri" type="string" />
        <field id="lineup" type="assocarray" />
        <field id="fromCache" type="boolean" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/LineupTask.brs" />
</component>
