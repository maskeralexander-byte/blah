<?xml version="1.0" encoding="utf-8" ?>
<!-- "Now playing" card that slides in at the top right, like a YouTube info card. -->
<component name="Timecard" extends="Group">
    <interface>
        <!-- { kicker, title, meta, progress (0..1, or -1 for none) } -->
        <field id="info" type="assocarray" onChange="onInfo" />
        <field id="dismiss" type="boolean" onChange="onDismiss" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/Timecard.brs" />

    <children>
        <Group id="card" translation="[1940, 56]">
            <Poster uri="pkg:/images/timecard.png" width="640" height="196" />
            <Rectangle translation="[32, 30]" width="10" height="10" color="0xFF5FA2FF" />
            <Label id="kicker" translation="[52, 20]" width="560" color="0x3FE0D0FF">
                <Font role="font" uri="pkg:/fonts/Poppins-SemiBold.ttf" size="22" />
            </Label>
            <Label id="title" translation="[32, 50]" width="576" color="0xFFFFFFFF">
                <Font role="font" uri="pkg:/fonts/Poppins-SemiBold.ttf" size="36" />
            </Label>
            <Label id="meta" translation="[32, 104]" width="576" color="0xC9C6EEFF">
                <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="25" />
            </Label>
            <Rectangle id="track" translation="[32, 152]" width="576" height="6" color="0xFFFFFF26" />
            <Poster id="bar" translation="[32, 152]" width="0" height="6" uri="pkg:/images/bar.png" />
        </Group>

        <Animation id="slideIn" duration="0.45" easeFunction="outCubic">
            <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[[1940, 56], [1236, 56]]" fieldToInterp="card.translation" />
        </Animation>
        <Animation id="slideOut" duration="0.35" easeFunction="inCubic">
            <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[[1236, 56], [1940, 56]]" fieldToInterp="card.translation" />
        </Animation>
        <Timer id="hideTimer" duration="7" />
    </children>
</component>
