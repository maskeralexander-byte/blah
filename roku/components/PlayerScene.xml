<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScene" extends="Scene">
    <interface>
        <!-- ECP parameters from main.brs: contentId, title, format, ua, ref, lineup, index, v; or resume. -->
        <field id="request" type="assocarray" onChange="onRequest" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/PlayerScene.brs" />

    <children>
        <Poster id="background" width="1920" height="1080" uri="pkg:/images/bg.png" />

        <!-- Guide backdrop, drawn under the video so the video shows live in the preview box. -->
        <Group id="guideBg" visible="false">
            <Poster width="1920" height="1080" uri="pkg:/images/bg.png" />
            <Poster width="1920" height="440" uri="pkg:/images/header.png" />
            <Poster translation="[88, 52]" width="496" height="286" uri="pkg:/images/timecard.png" />
            <Poster id="previewLogoBig" translation="[136, 95]" width="400" height="200" loadDisplayMode="scaleToFit" />
        </Group>

        <Video id="video" width="1920" height="1080" enableUI="false" />

        <!-- Idle / loading / error screen. -->
        <Poster id="idleArt" width="1920" height="1080" uri="pkg:/images/splash_fhd.jpg" />
        <Label id="title" translation="[96, 640]" width="1728" horizAlign="center" color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/fonts/Poppins-SemiBold.ttf" size="48" />
        </Label>
        <Label id="status" translation="[160, 716]" width="1600" horizAlign="center" wrap="true" color="0xC9C6EEFF"
            text="Pick a channel on your phone and tap the cast icon.">
            <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="30" />
        </Label>

        <!-- Channel banner: appears on channel change and on Left/Right. -->
        <Group id="banner" visible="false">
            <Poster translation="[0, 760]" width="1920" height="320" uri="pkg:/images/banner.png" />
            <Label id="bannerNumber" translation="[96, 836]" width="240" color="0x9B7BFFFF">
                <Font role="font" uri="pkg:/fonts/Bungee-Regular.ttf" size="84" />
            </Label>
            <Label id="bannerName" translation="[340, 836]" width="1480" color="0xFFFFFFFF">
                <Font role="font" uri="pkg:/fonts/Poppins-SemiBold.ttf" size="46" />
            </Label>
            <Label id="bannerNow" translation="[340, 904]" width="1480" color="0xFFFFFFFF">
                <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="30" />
            </Label>
            <Label id="bannerNext" translation="[340, 950]" width="1480" color="0xC9C6EEFF">
                <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="26" />
            </Label>
            <Label translation="[340, 1002]" width="1480" color="0x8F8BB8FF"
                text="▲▼ CHANNEL     OK GUIDE     ◀▶ INFO     BACK EXIT">
                <Font role="font" uri="pkg:/fonts/Poppins-SemiBold.ttf" size="20" />
            </Label>
        </Group>

        <Timecard id="timecard" />

        <!-- Short confirmations ("Added to Favorites") and typed channel numbers. -->
        <Group id="toast" visible="false" translation="[760, 60]">
            <Poster width="400" height="88" uri="pkg:/images/timecard.png" />
            <Label id="toastText" width="400" height="88" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
                <Font role="font" uri="pkg:/fonts/Poppins-SemiBold.ttf" size="28" />
            </Label>
        </Group>
        <Label id="digits" translation="[1580, 60]" width="260" horizAlign="right" visible="false" color="0x3FE0D0FF">
            <Font role="font" uri="pkg:/fonts/Bungee-Regular.ttf" size="96" />
        </Label>

        <!-- Cable-style guide: preview header, category menu with search, and a time grid. -->
        <Group id="guide" visible="false">
            <!-- Preview of the focused programme (the live picture sits in the box on the left). -->
            <Poster id="previewLogo" translation="[640, 62]" width="150" height="84" loadDisplayMode="scaleToFit" />
            <Label id="previewKicker" translation="[812, 58]" width="700" color="0x3FE0D0FF" text="ON NOW">
                <Font role="font" uri="pkg:/fonts/Poppins-SemiBold.ttf" size="22" />
            </Label>
            <Label id="previewTitle" translation="[812, 86]" width="840" color="0xFFFFFFFF">
                <Font role="font" uri="pkg:/fonts/Poppins-SemiBold.ttf" size="52" />
            </Label>
            <Label id="previewChannel" translation="[640, 162]" width="1000" color="0xDDDAFFFF">
                <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="30" />
            </Label>
            <Label id="previewTime" translation="[640, 206]" width="1000" color="0xFF8FC0FF">
                <Font role="font" uri="pkg:/fonts/Poppins-SemiBold.ttf" size="26" />
            </Label>
            <Label id="previewDesc" translation="[640, 248]" width="1180" height="120" wrap="true" maxLines="3" color="0xE6E4FFFF">
                <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="25" />
            </Label>
            <Label id="clock" translation="[1500, 52]" width="324" horizAlign="right" color="0xFFFFFFFF">
                <Font role="font" uri="pkg:/fonts/Bungee-Regular.ttf" size="44" />
            </Label>
            <Label id="hint" translation="[1300, 112]" width="524" horizAlign="right" color="0x9F9BD0FF"
                text="OK WATCH   ·   ✱ FAVORITE   ·   ◀ MENU   ·   BACK CLOSE">
                <Font role="font" uri="pkg:/fonts/Poppins-SemiBold.ttf" size="18" />
            </Label>

            <!-- Category menu. -->
            <Rectangle translation="[0, 440]" width="380" height="640" color="0x0B0A1AB0" />
            <LabelList id="menu" translation="[40, 480]" itemSize="[310, 60]" numRows="9"
                color="0xDDDAFFFF" focusedColor="0x0B0A1AFF">
                <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="28" />
                <Font role="focusedFont" uri="pkg:/fonts/Poppins-SemiBold.ttf" size="28" />
            </LabelList>

            <!-- Search (replaces the menu while active). -->
            <Group id="searchPanel" visible="false">
                <Rectangle translation="[0, 440]" width="380" height="640" color="0x0B0A1AE6" />
                <Label translation="[30, 466]" width="330" color="0x3FE0D0FF" text="SEARCH CHANNELS &amp; SHOWS">
                    <Font role="font" uri="pkg:/fonts/Poppins-SemiBold.ttf" size="20" />
                </Label>
                <Label id="searchText" translation="[30, 505]" width="330" color="0xFFFFFFFF" text=" ">
                    <Font role="font" uri="pkg:/fonts/Poppins-SemiBold.ttf" size="34" />
                </Label>
                <Rectangle translation="[30, 552]" width="330" height="3" color="0x9B7BFFFF" />
                <MiniKeyboard id="keyboard" translation="[16, 576]" />
            </Group>

            <TimeGrid id="grid" translation="[400, 456]" numRows="6" duration="7200"
                channelInfoComponentName="ChannelCell" channelInfoWidth="230" infoGridGap="6"
                channelNoDataText="Live programming" loadingDataText="Loading guide…"
                programTitleColor="0xEDEBFFFF" programTitleFocusedColor="0x0B0A1AFF"
                timeLabelColor="0xC9C6EEFF" timeBarHeight="56"
                focusBitmapUri="pkg:/images/grid_focus.9.png"
                programBackgroundBitmapUri="pkg:/images/grid_program.9.png"
                channelInfoBackgroundBitmapUri="pkg:/images/grid_channel.9.png"
                timeBarBitmapUri="pkg:/images/grid_timebar.9.png"
                nowBarBlendColor="0xFF5FA2FF" pastTimeScreenBlendColor="0x0B0A1AFF"
                programHorizMargin="16" fillProgramGaps="true">
                <Font role="programTitleFont" uri="pkg:/fonts/Poppins-SemiBold.ttf" size="24" />
                <Font role="timeLabelFont" uri="pkg:/fonts/Poppins-SemiBold.ttf" size="22" />
            </TimeGrid>
            <Label id="emptyText" translation="[400, 700]" width="1440" horizAlign="center" visible="false"
                color="0xDDDAFFFF" text="No channels here yet.">
                <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="32" />
            </Label>
        </Group>

        <Timer id="bannerTimer" duration="6" />
        <Timer id="refreshTimer" duration="1800" repeat="true" />
        <Timer id="toastTimer" duration="2.5" />
        <Timer id="digitsTimer" duration="1.6" />
        <Timer id="clockTimer" duration="20" repeat="true" />
        <Timer id="searchTimer" duration="0.6" />
        <Timer id="programTimer" duration="20" repeat="true" />
    </children>
</component>
